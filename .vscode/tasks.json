{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: Run Active File",
            "type": "shell",
            "command": "go run",
            "args": [
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "Go: Run Active Package",
            "type": "shell",
            "command": "go run",
            "args": [
                "${fileDirname}"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "Go: Run Tests in Package",
            "type": "shell",
            "command": "go test",
            "args": [
                "-v",
                "${fileDirname}"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$go"
            ]
        }
    ]
}
